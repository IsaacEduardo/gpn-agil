APP_NAME=GPN-AGIL
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

DOCS_STORAGE_DISK=local

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gpn_agil
DB_USERNAME=gpn_agil
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# Broadcasting
BROADCAST_DRIVER=log

# Pusher (para tempo real via Laravel Echo)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
# Se usar servidor próprio de websockets, configure host/porta abaixo
PUSHER_HOST=
PUSHER_PORT=
PUSHER_SCHEME=https
PUSHER_USETLS=true

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@gpn-agil.local"
MAIL_FROM_NAME="GPN-AGIL"
