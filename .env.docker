APP_NAME=GPN-AGIL
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
# Chave da rota utilitária /deploy-setup. Deixe VAZIO para manter a rota desativada.
# Defina um segredo forte e único APENAS no ambiente real (nunca versione o valor).
APP_DEPLOY_KEY=


DOCS_STORAGE_DISK=local

LOG_CHANNEL=stack
LOG_LEVEL=info

# ATENÇÃO: credenciais abaixo são apenas para o ambiente Docker LOCAL de desenvolvimento.
# NÃO reutilize estes valores em produção — defina senhas fortes via variáveis de ambiente.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gpn_agil
DB_USERNAME=gpn_agil
DB_PASSWORD=gpn_local_dev_only__troque_isto
DB_ROOT_PASSWORD=gpn_local_dev_root__troque_isto

# Credenciais do admin inicial criado pelo InitialRolesAndAdminSeeder.
# Sem estes valores o seeder NÃO cria nenhum utilizador admin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Broadcasting
BROADCAST_DRIVER=log

# Pusher (para tempo real via Laravel Echo)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
# Se usar servidor próprio de websockets, configure host/porta abaixo
PUSHER_HOST=
PUSHER_PORT=
PUSHER_SCHEME=https
PUSHER_USETLS=true

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Redis (serviço 'redis' do docker-compose)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
FILESYSTEM_DISK=local
# Fila assíncrona processada pelo serviço 'queue' (php artisan queue:work).
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@gpn-agil.local"
MAIL_FROM_NAME="GPN-AGIL"
