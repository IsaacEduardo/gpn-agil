APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Ative (true) apenas em desenvolvimento local. NUNCA em produção.
APP_DEBUG=false
APP_URL=http://localhost
WEBSCAN_AGENT_URL=http://127.0.0.1:18090
APP_DEPLOY_KEY=

# Credenciais do admin inicial criado pelo InitialRolesAndAdminSeeder.
# Sem estes valores o seeder NÃO cria nenhum utilizador admin.
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=


DOCS_STORAGE_DISK=local

# Fuso horário da aplicação. O fuso oficial de referência é Africa/Luanda
# (UTC+1); fica em UTC por omissão porque os registos existentes foram gravados
# em UTC e mudar este valor reinterpreta-os (desloca-os uma hora). Antes de
# passar para Africa/Luanda é preciso converter os carimbos já gravados — em
# documentação administrativa a hora tem valor probatório.
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# Conexões PDO persistentes ao MySQL (workaround WSAEACCES/reserva de portas no Windows).
# Padrão desligado. Use com cautela em produção (mantém conexões abertas).
# DB_PERSISTENT=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting
BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log

# Serviço de Renderização PDF (Gotenberg)
GOTENBERG_URL=http://127.0.0.1:3000

# Edição colaborativa em tempo real (Laravel Reverb).
# Requer processo long-running (VPS/Docker) — NÃO ativar em cPanel/shared hosting.
# Para ativar: FEATURE_COLLAB=true, BROADCAST_CONNECTION=reverb, e preencher as chaves abaixo
# (geradas por `php artisan reverb:install`). Ver docs/MANUAL_DEPLOY.md.
FEATURE_COLLAB=false
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Variáveis expostas ao frontend (Vite/Echo). Em produção, REVERB_HOST público e REVERB_SCHEME=https (wss).
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Pusher (para tempo real via Laravel Echo)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
# Para usar host/porta custom (ex.: websockets self-hosted), mantenha em branco se for pusher.com
PUSHER_HOST=
PUSHER_PORT=
PUSHER_SCHEME=https
PUSHER_USETLS=true

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
 
# Feature flags
# Habilita o fluxo de visto do departamento antes da aprovação
FEATURE_VISTO_DEPARTAMENTO=false

# Assistente de IA (chatbot sobre documentos, com controlo de acesso por perfil)
FEATURE_ASSISTENTE=false
# Provedor de IA do Assistente: 'deepseek' (DeepSeek) | 'openai' (ChatGPT) | 'kimi' (Moonshot) | 'anthropic' | 'fake'
ASSISTENTE_DRIVER=deepseek
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
KIMI_API_KEY=
ANTHROPIC_API_KEY=
# Modelos: DeepSeek ('deepseek-chat', 'deepseek-reasoner'), OpenAI ('gpt-4o-mini'), Kimi ('moonshot-v1-8k') ou Anthropic
ASSISTENTE_MODEL=deepseek-chat
ASSISTENTE_MODEL_FAST=deepseek-chat
ASSISTENTE_MAX_TOKENS=1024
ASSISTENTE_CONTEXT_CHARS=24000

# Chatbot RAG (busca semântica sobre documentos)
CHATBOT_ENABLED=false
# Embeddings on-premise via Ollama (nenhum dado sai da instituição)
EMBEDDINGS_DRIVER=ollama
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_DIM=768
# Vector store: mysql (sem nova infra) | (futuro: qdrant, pgvector)
CHATBOT_VECTOR_DRIVER=mysql
CHATBOT_TOPK=6
CHATBOT_CHUNK_SIZE=1000
CHATBOT_CHUNK_OVERLAP=150
CHATBOT_HYBRID=true
CHATBOT_QUEUE=default
CHATBOT_RATE_LIMIT=20
# OpenAI (apenas se EMBEDDINGS_DRIVER=openai)
OPENAI_API_KEY=
# ------------------------------------------------------------------------------
# Performance & Concurrency
# ------------------------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false

# Cache/Sessão/Fila - recomendado usar Redis em produção
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis

# Otimizações Laravel (executar via artisan)
# php artisan config:cache
# php artisan route:cache
# php artisan view:cache

# ------------------------------------------------------------------------------
# Processamento de Documentos e OCR (Tesseract)
# ------------------------------------------------------------------------------
# Caminho para o executável do Tesseract (deixe vazio para auto-detecção no PATH/locais comuns)
# OCR_BINARY_PATH="C:/Program Files/Tesseract-OCR/tesseract.exe"
# Diretório de dados de treino (.traineddata) customizado (padrão: storage/app/tessdata)
# OCR_TESSDATA_PATH=
# Idiomas padrão para reconhecimento (ex: por, por+eng, eng)
OCR_LANGUAGES=por+eng
# Limite de palavras para considerar PDF pesquisável nativamente sem rodar OCR
OCR_MIN_NATIVE_WORDS=50
# Utilitários auxiliares opcionais para conversão de PDF para imagem a 300 DPI
# Rasterizador de PDF para OCR de documentos digitalizados (Poppler).
# Sem ele, um PDF de scanner e imagem pura e nao fica pesquisavel.
# OCR_PDFTOPPM_PATH=
# OCR_GS_PATH=
# OCR_MAGICK_PATH=
OCR_DPI=300
